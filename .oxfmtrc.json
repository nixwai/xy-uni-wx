{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "vueIndentScriptAndStyle": false,
  "ignorePatterns": ["dist/**", "unpackage/**", "node_modules/**", "coverage/**", "static/**"]
}
